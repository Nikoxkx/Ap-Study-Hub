# Public site origin used for canonical URLs, sitemap, and social metadata.
NEXT_PUBLIC_SITE_URL=https://v0-project-roan-six-20.vercel.app

# Optional Study Desk sync. Leave blank to keep the site local-only.
# This is the public edge-function URL, NOT a secret or service-role key.
NEXT_PUBLIC_STUDY_SYNC_URL=

# The following live only in Supabase edge-function secrets:
# STUDY_SYNC_PEPPER
# STUDY_SYNC_ALLOWED_ORIGIN
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.
