{
  "name": "ap-study-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Learn ten AP subjects deeply with free lessons, recall cards, original practice, full-length interim assessments with real rubric grading, and unit videos that can lead to college credit where accepted.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nikoxkx/Ap-Study-Hub.git"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-lessons.ts",
    "validate:study": "tsx scripts/validate-study.ts",
    "build:banners": "node assets/readme/build-banners.mjs",
    "build:social": "node scripts/build-social-image.mjs",
    "validate:videos": "tsx scripts/validate-videos.ts",
    "validate:presentation": "node scripts/validate-presentation.mjs",
    "export:videos": "tsx scripts/export-video-registry.ts",
    "check": "corepack pnpm validate:content && corepack pnpm validate:exams && corepack pnpm validate:grading && corepack pnpm validate:exam-ui && corepack pnpm validate:exam-flow && corepack pnpm validate:scroll && corepack pnpm validate:study && corepack pnpm validate:presentation && corepack pnpm validate:videos && corepack pnpm typecheck && corepack pnpm lint && corepack pnpm build",
    "validate:exams": "tsx scripts/validate-exams.ts",
    "validate:grading": "tsx scripts/validate-grading.ts",
    "validate:exam-ui": "tsx scripts/validate-exam-ui.tsx",
    "validate:exam-flow": "tsx scripts/validate-exam-flow.tsx",
    "validate:scroll": "tsx scripts/validate-scroll-lock.ts"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "4.1.17",
    "@types/jsdom": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "postcss": "8.5.31",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
